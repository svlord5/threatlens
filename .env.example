# =============================================================================
# ThreatLens environment template. Copy to .env and fill in. Never commit .env.
# =============================================================================

# --- Supabase (Postgres: app data, realtime, and all authentication) ---------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_...
SUPABASE_SECRET_KEY=                    # sb_secret_... (server only)
# Legacy fallbacks, only if you have not moved to the new key format:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where /terms, /privacy, /cookies, /disclaimer, /security, /report, /contact and /legal redirect to
# (default https://surajv5.in, no trailing slash)
# LEGAL_BASE_URL=https://surajv5.in

# --- Discord (bot lookups, alert webhook; NOT used for sign-in) ----------------
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK=
# Discord user ID of the super admin (server-only; never expose via NEXT_PUBLIC_)
SUPER_ADMIN_DISCORD_ID=
# Email of the super admin (must be a confirmed email on the Supabase account).
# Also admins: any iam_discord_invites row with super_admin=true.
SUPER_ADMIN_EMAIL=

# --- SIEM agent / Wazuh ------------------------------------------------------
# REQUIRED for /api/siem/ingest and /api/integrations/wazuh. Generate with:
#   openssl rand -hex 32
# If unset those routes return 500; there is no default key.
SIEM_AGENT_API_KEY=
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USER=
WAZUH_API_PASSWORD=
# Verify the manager cert by pinning its CA (PEM contents) ...
WAZUH_CA_CERT=
# ... or, for local labs only, skip verification:
# WAZUH_TLS_INSECURE=true

# --- Threat intelligence / AI APIs -------------------------------------------
GEMINI_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
ABSTRACT_API_KEY=
NUMVERIFY_API_KEY=
HIBP_API_KEY=
OTX_API_KEY=
TRUECALLER_API_KEY=
NPCI_API_KEY=

# --- Cloudflare Turnstile ----------------------------------------------------
CLOUDFLARE_SITE_TURNSTILE_KEY=
NEXT_PUBLIC_CLOUDFLARE_SITE_TURNSTILE_KEY=
# REQUIRED in production: the access-request form refuses submissions without it.
CLOUDFLARE_SECRET_TURNSTILE_KEY=

# Optional: Discord user ID pinged on new access requests
ACCESS_NOTIFY_DISCORD_ID=

# --- Rate limiting (see src/lib/rate-limit.ts and src/lib/limits.ts) ----------
# Upstash Redis REST store. REQUIRED on Vercel/serverless: without it limits are
# per-instance only and effectively not enforced.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Everything below is optional; the built-in defaults are already strict. 0 = unlimited.
# Per IP, all API routes (per minute) and agent routes (per minute):
# RATE_LIMIT_API=60
# RATE_LIMIT_INGEST=120
# Public access-request form (per hour) and status lookups (per minute), per IP:
# RATE_LIMIT_ACCESS_REQUEST=3
# RATE_LIMIT_ACCESS_LOOKUP=15
# RATE_LIMIT_ACCESS_EMAIL=1        # per email address per day
# Costly services. GROUP = FORENSICS | VIRUSTOTAL | SHODAN | GEMINI
#   RATE_LIMIT_<GROUP>_USER_PER_MIN   (defaults 10 / 4 / 4 / 6)
#   RATE_LIMIT_<GROUP>_IP_PER_MIN     (defaults 20 / 8 / 8 / 12)
#   RATE_LIMIT_<GROUP>_USER_PER_DAY   (defaults 200 / 100 / 40 / 60)
#   RATE_LIMIT_<GROUP>_DAILY_CAP      (global; defaults 2000 / 400 / 150 / 300)
# RATE_LIMIT_FAIL_OPEN=false   # true = allow requests if the store is down

# --- Website scanner ---------------------------------------------------------
# Only if your container cannot grant Chromium its sandbox (see the route comment).
# PUPPETEER_NO_SANDBOX=1

# --- Demo vs live mode (see src/lib/demo.ts) -----------------------------------
# With NO Supabase values above, the app starts in DEMO mode on synthetic data: no
# database, no sign-in, nothing saved. Set the Supabase values and it runs LIVE.
# Force demo mode even when Supabase is configured:
# NEXT_PUBLIC_DEMO_MODE=true
# Make one account on a LIVE deployment read-only:
# DEMO_ACCOUNT_EMAIL=
